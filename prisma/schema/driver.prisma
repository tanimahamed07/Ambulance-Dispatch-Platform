model Driver {
  id             String               @id @default(uuid())
  contactNumber  String
  address        String
  licenseNumber  String               @unique
  licenseUrl     String
  licensePublicId String
  licenseExpiry  DateTime
  nidNumber      String              @unique

  // Verification Status & Shift Logic
  approvalStatus   DriverApprovalStatus @default(PENDING)
  dutyStatus       DriverDutyStatus     @default(OFF_DUTY)

  currentLatitude  Float?
  currentLongitude Float?
  
  // Rejection Tracking Fields 👈
  rejectionReason RejectionReason?    
  rejectionNote   String?             
  rejectedAt      DateTime?           

  // User & Ambulance Relations
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  ambulanceId    String?              @unique
  ambulance      Ambulance?           @relation(fields: [ambulanceId], references: [id])

  // Soft Delete Fields
  isDeleted      Boolean              @default(false)
  deletedAt      DateTime?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("drivers")
}