model Hospital {
id String @id @default(uuid())
name String
phone String
email String?
address String
latitude Float
longitude Float
emergencyAvailable Boolean @default(true)
specialties String[]
status HospitalStatus @default(ACTIVE)
trips Trip[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([status])
@@index([emergencyAvailable])

@@map("hospitals")
}