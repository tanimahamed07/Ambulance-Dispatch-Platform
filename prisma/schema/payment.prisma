model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2) // 100.50
  currency String  @default("BDT")

  paymentGateway        String  @default("bkash")
  merchantInvoiceNumber String? @unique // trip id

  bkashPaymentID      String?   @unique
  trxID               String?
  payerReference      String? // user phone number
  paymentCreateTime   DateTime?
  paymentExecuteTime  DateTime?
  failureReason       String?

  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}
